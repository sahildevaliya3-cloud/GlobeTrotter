generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  photoUrl     String?  @map("photo_url")
  createdAt    DateTime @default(now()) @map("created_at")
  trips        Trip[]

  @@map("users")
}

model Trip {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  name          String
  description   String?
  startDate     DateTime @map("start_date") @db.Date
  endDate       DateTime @map("end_date") @db.Date
  coverPhotoUrl String?  @map("cover_photo_url")
  targetBudget  Decimal? @map("target_budget") @db.Decimal(10, 2)
  isPublic      Boolean  @default(false) @map("is_public")
  createdAt     DateTime @default(now()) @map("created_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stops         Stop[]

  @@map("trips")
}

model City {
  id              String     @id @default(uuid()) @db.Uuid
  name            String
  country         String
  costIndex       Float      @map("cost_index")
  popularityScore Int        @map("popularity_score")
  imageUrl        String?    @map("image_url")
  stops           Stop[]
  activities      Activity[]

  @@map("cities")
}

model Stop {
  id            String          @id @default(uuid()) @db.Uuid
  tripId        String          @map("trip_id") @db.Uuid
  cityId        String          @map("city_id") @db.Uuid
  startDate     DateTime        @map("start_date") @db.Date
  endDate       DateTime        @map("end_date") @db.Date
  orderIndex    Int             @map("order_index")
  trip          Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  city          City            @relation(fields: [cityId], references: [id], onDelete: Restrict)
  tripActivities TripActivity[]

  @@map("stops")
}

model Activity {
  id            String          @id @default(uuid()) @db.Uuid
  cityId        String          @map("city_id") @db.Uuid
  name          String
  category      String
  cost          Decimal         @db.Decimal(10, 2)
  durationHours Float           @map("duration_hours")
  description   String?
  imageUrl      String?         @map("image_url")
  city          City            @relation(fields: [cityId], references: [id], onDelete: Cascade)
  tripActivities TripActivity[]

  @@map("activities")
}

model TripActivity {
  id            String    @id @default(uuid()) @db.Uuid
  stopId        String    @map("stop_id") @db.Uuid
  activityId    String    @map("activity_id") @db.Uuid
  scheduledDate DateTime  @map("scheduled_date") @db.Date
  scheduledTime DateTime  @map("scheduled_time") @db.Time(0)
  customCost    Decimal?  @map("custom_cost") @db.Decimal(10, 2)
  stop          Stop      @relation(fields: [stopId], references: [id], onDelete: Cascade)
  activity      Activity  @relation(fields: [activityId], references: [id], onDelete: Restrict)

  @@map("trip_activities")
}
