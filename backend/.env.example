# GlobeTrotter Backend Environment Configuration Example

# Server Listening Port
PORT=3001

# PostgreSQL Database Connection String (Supabase / Neon / Render Postgres)
DATABASE_URL="postgresql://postgres:your_password@ep-example-123456.us-east-1.aws.neon.tech/globetrotter?sslmode=require"

# Secret key used for signing JWT tokens (generate a strong random string for production)
JWT_SECRET="replace-with-your-secure-production-jwt-secret-min-32-chars"

# Secret key for express-session (used only during OAuth redirect dance)
SESSION_SECRET="replace-with-a-different-secure-random-string"

# Allowed Frontend Client Origin(s) for CORS (comma-separated if multiple)
CLIENT_ORIGIN="https://globetrotter.vercel.app,http://localhost:5173"

# Frontend base URL — used to build OAuth redirect URLs after callback
FRONTEND_URL="http://localhost:5173"

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Application type: Web application
# Authorised redirect URIs must include GOOGLE_CALLBACK_URL exactly.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Dev: http://localhost:3001/auth/google/callback
# Prod: https://api.yourdomain.com/auth/google/callback
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"

# ── Apple Sign In ─────────────────────────────────────────────────────────────
# REQUIRES a paid Apple Developer account ($99/yr).
# Setup at: https://developer.apple.com  → Certificates, Identifiers & Profiles
#   1. Create an App ID with "Sign In with Apple" capability
#   2. Create a Services ID (this becomes APPLE_CLIENT_ID) and configure
#      the Return URL to match APPLE_CALLBACK_URL
#   3. Create a Sign In with Apple key under Keys — download the .p8 file
#   4. APPLE_PRIVATE_KEY = contents of the .p8 file with \n for line breaks
# NOTE: Apple requires HTTPS for callback URLs even in some dev environments.
#       Use ngrok or similar to expose localhost over HTTPS for local testing.
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
# Prod: https://api.yourdomain.com/auth/apple/callback (MUST be HTTPS)
APPLE_CALLBACK_URL="https://api.yourdomain.com/auth/apple/callback"

