{
  "name": "globetrotter",
  "version": "1.0.0",
  "private": true,
  "description": "GlobeTrotter — Full-Stack Travel Planner",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --prefix-colors \"bgBlue.bold,bgMagenta.bold\" --names \"SERVER,CLIENT\" \"npm run server\" \"npm run client\"",
    "server": "npm run dev --prefix backend",
    "client": "npm run dev --prefix frontend",
    "postinstall": "echo \"Root level - no postinstall needed\""
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
